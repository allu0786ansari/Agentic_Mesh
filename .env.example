# Local secrets. Copy this file to .env and fill in the values:
#   cp .env.example .env
# .env is git-ignored and never committed. The command-line tools (make kb,
# make retrieval-eval, make mesh, make llm-calibrate) read it at start-up. A variable
# already exported in your shell wins over .env.

# Hugging Face access token, read-only is enough: https://huggingface.co/settings/tokens
# Without it the Hub warns about unauthenticated requests and rate-limits them, so
# loading all-MiniLM-L6-v2 is slower.
HF_TOKEN=

# HMAC key of the approval gate for high-impact actions (ADR 0012 §5), at least 16
# bytes. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
MESH_APPROVAL_KEY=
